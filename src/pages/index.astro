---
import SiteLayout from '../layouts/SiteLayout.astro';
---
<SiteLayout title="Home">
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <div class="eyebrow"><span class="signal"></span> PERSONAL RESEARCH PORTFOLIO</div>
        <h1>Exploring how<br /><em>robots move.</em></h1>
        <p>I study robotic locomotion, mechanical compliance, and the relationship between physical design and motion.</p>
        <div class="actions"><a class="button primary" href="/research/">Explore research <span>↗</span></a><a class="button ghost" href="/projects/">View projects</a></div>
      </div>
      <div class="hero-art" aria-label="Placeholder for robot image or video">
        <div class="orbit orbit-1"></div><div class="orbit orbit-2"></div>
        <div class="art-center"><div class="art-symbol">⌁</div><span>YOUR ROBOT VIDEO / PHOTO</span><small>Replace this area with your own footage later</small></div>
        <div class="art-label">ROBOTICS / LOCOMOTION</div>
      </div>
    </div>
  </section>
  <section class="section wrap">
    <div class="section-top"><div><span class="kicker">RESEARCH</span><h2>Featured research</h2></div><a class="text-link" href="/research/">All research ↗</a></div>
    <div class="cards">
      <a class="feature-card" href="/research/"><div class="card-art art-a"><span>01 / QUADRUPED</span><strong>GAIT &<br />COMPLIANCE</strong></div><div class="card-details"><h3>Stiffness and Quadruped Gait</h3><p>Understanding how mechanical and joint stiffness influence locomotion.</p><span class="pill">Ongoing research</span></div></a>
      <a class="feature-card" href="/research/"><div class="card-art art-b"><span>02 / MODELING</span><strong>SIMULATION<br />× REALITY</strong></div><div class="card-details"><h3>Actuator Modeling & Simulation</h3><p>Connecting experimental data and MuJoCo models.</p><span class="pill">Ongoing research</span></div></a>
    </div>
  </section>
  <section class="section alt"><div class="wrap section-top"><div><span class="kicker">PROJECTS</span><h2>Beyond the laboratory</h2><p class="section-description">Robots, prototyping, electronics, and things I build.</p></div><a class="text-link" href="/projects/">See projects ↗</a></div></section>
  <section class="wrap closing"><h2>Research is a work in progress.</h2><p>This website is an early version. Research details, photos, publications, and videos will be added over time.</p><a class="button primary" href="/about/">About this site ↗</a></section>
</SiteLayout>
